+{
+   const unsigned slots = glsl_count_attribute_slots(var->type, false);
+   for (unsigned s = 0; s < slots; s++) {
+      const unsigned slot = var->data.location + s;
+      if (slot < VARYING_SLOT_MAX)
+         reads[slot] |= comps & 0xf;
